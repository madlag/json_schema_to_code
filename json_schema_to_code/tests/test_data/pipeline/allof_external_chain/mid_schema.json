{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/mid_schema",
  "$defs": {
    "MidProblem": {
      "allOf": [
        { "$ref": "/base_schema#/$defs/BaseProblem" },
        { "type": "object", "properties": { "level": { "type": "integer", "default": 1 } } }
      ]
    },
    "MidData": {
      "description": "one hop: narrows problem, redeclares nothing about required",
      "allOf": [
        { "$ref": "/base_schema#/$defs/ActivityData" },
        { "type": "object", "properties": { "problem": { "$ref": "#/$defs/MidProblem" } } }
      ]
    }
  }
}
